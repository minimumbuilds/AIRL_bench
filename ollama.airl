;; ollama.airl — Ollama API client module
;;
;; Provides functions for interacting with the Ollama /api/generate endpoint.

;; Escape a string for JSON embedding (workaround for json-stringify not escaping newlines)
(defn json-escape
  :sig [(s : String) -> String]
  :intent "Escape backslashes, quotes, and newlines for JSON string values"
  :requires [(valid s)]
  :ensures [(valid result)]
  :body
    (let (escaped-bs : String (replace s "\\" "\\\\"))
         (escaped-qt : String (replace escaped-bs "\"" "\\\""))
         (escaped-nl : String (replace escaped-qt "\n" "\\n"))
         (escaped-cr : String (replace escaped-nl "\r" "\\r"))
         (escaped-tab : String (replace escaped-cr "\t" "\\t"))
      escaped-tab))

;; Build a JSON request body for Ollama /api/generate
(defn build-request-body
  :sig [(model : String) (prompt : String) -> String]
  :intent "Build a JSON request body for the Ollama generate endpoint"
  :requires [(not (= model "")) (not (= prompt ""))]
  :ensures [(contains result "model") (contains result "prompt")]
  :body
    (str "{\"model\":\"" (json-escape model)
         "\",\"prompt\":\"" (json-escape prompt)
         "\",\"stream\":false}"))

;; Send a prompt to Ollama and return the parsed response map
;; Uses curl via shell-exec (alternatively, use AIReqL library for HTTP)
(defn query-ollama
  :sig [(host : String) (model : String) (prompt : String) -> Result[Map, String]]
  :intent "POST a generate request to Ollama via curl and return the parsed JSON response"
  :requires [(not (= host "")) (not (= model ""))]
  :ensures [(valid result)]
  :body
    (let (url : String (str host "/api/generate"))
         (req-body : String (build-request-body model prompt))
         (tmp-path : String "output/.ollama_request.json")
      (do
        (write-file tmp-path req-body)
        (match (shell-exec "curl" ["-sf" "-X" "POST" url "-H" "Content-Type: application/json" "-d" (str "@" tmp-path)])
          (Ok response-text)
            (match (json-parse response-text)
              (Ok parsed-map) (Ok parsed-map)
              (Err parse-err) (Err (str "JSON parse error: " parse-err)))
          (Err curl-err)
            (Err (str "HTTP error: " curl-err))))))

;; Strip trailing markdown fence from extracted code
(defn strip-trailing-fence
  :sig [(code : String) -> String]
  :intent "Remove a trailing ``` that the LLM appended without an opening fence"
  :requires [(valid code)]
  :ensures [(valid result)]
  :body
    (let (trimmed : String (trim code))
      (if (ends-with trimmed "```")
        (trim (substring trimmed 0 (- (length trimmed) 3)))
        trimmed)))

;; Extract code from between markdown fences, or return text as-is
(defn extract-code
  :sig [(response-text : String) (language : String) -> String]
  :intent "Strip markdown code fences from LLM output"
  :requires [(valid response-text)]
  :ensures [(valid result)]
  :body
    (let (fence-open : String (str "```" language "\n"))
         (open-idx : i64 (index-of response-text fence-open))
      (if (= open-idx -1)
        ;; No language-specific fence — try bare ```
        (let (bare-idx : i64 (index-of response-text "```"))
          (if (= bare-idx -1)
            response-text
            (let (after-open : i64 (+ bare-idx 3))
                 (nl-idx : i64 (index-of (substring response-text after-open (length response-text)) "\n"))
              (if (= nl-idx -1)
                response-text
                (let (code-start : i64 (+ after-open (+ nl-idx 1)))
                     (close-idx : i64 (index-of (substring response-text code-start (length response-text)) "```"))
                  (if (= close-idx -1)
                    response-text
                    (trim (substring response-text code-start (+ code-start close-idx)))))))))
        ;; Found language-specific fence
        (let (code-start : i64 (+ open-idx (length fence-open)))
             (rest : String (substring response-text code-start (length response-text)))
             (close-idx : i64 (index-of rest "```"))
          (if (= close-idx -1)
            response-text
            (trim (substring response-text code-start (+ code-start close-idx))))))))

;; Extract token usage counts from Ollama response
(defn get-token-counts
  :sig [(response-map : Map) -> Map]
  :intent "Extract prompt and completion token counts from an Ollama response"
  :requires [(valid response-map)]
  :ensures [(map-has result "prompt_tokens") (map-has result "completion_tokens")]
  :body
    (map-from
      ["prompt_tokens"     (map-get-or response-map "prompt_eval_count" 0)
       "completion_tokens" (map-get-or response-map "eval_count" 0)]))

;; ── Claude CLI backend ────────────────────────────────────────────

;; Send a prompt to Claude via the claude CLI and return a response map
(defn query-claude
  :sig [(model : String) (prompt : String) -> Result[Map, String]]
  :intent "Call claude -p with the given prompt and return a response map"
  :requires [(not (= model "")) (not (= prompt ""))]
  :ensures [(valid result)]
  :body
    (let (start-ms : i64 (time-now))
      (match (shell-exec "claude" ["-p" prompt "--output-format" "text" "--model" model])
        (Ok stdout)
          (let (elapsed : i64 (- (time-now) start-ms))
            (Ok (map-from
              ["response" stdout
               "prompt_eval_count" 0
               "eval_count" 0
               "total_duration" elapsed])))
        (Err e) (Err (str "claude exec failed: " e)))))

;; ── Unified query dispatcher ──────────────────────────────────────

;; Route to the appropriate backend based on backend name
(defn query-llm
  :sig [(backend : String) (host : String) (model : String) (prompt : String) -> Result[Map, String]]
  :intent "Send a prompt to the configured LLM backend"
  :requires [(not (= model "")) (not (= prompt ""))]
  :ensures [(valid result)]
  :body
    (if (= backend "claude")
      (query-claude model prompt)
      (query-ollama host model prompt)))
