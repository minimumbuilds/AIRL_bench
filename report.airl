;; report.airl — Generate markdown benchmark reports

;; Helper: boolean to PASS/FAIL string
(defn bool-str
  :sig [(b : Bool) -> String]
  :intent "Convert boolean to PASS/FAIL string"
  :requires [(valid b)]
  :ensures [(valid result)]
  :body (if b "PASS" "FAIL"))

;; ── Multi-run variance helpers ──────────────────────────────────

;; Integer square root via Newton's method (helper)
(defn isqrt-step
  :sig [(n : i64) (x : i64) -> i64]
  :intent "Newton's method iteration for integer square root"
  :requires [(> n 0) (> x 0)]
  :ensures [(>= result 0)]
  :body
    (let (next-x : i64 (/ (+ x (/ n x)) 2))
      (if (>= next-x x)
        x
        (isqrt-step n next-x))))

;; Integer square root
(defn isqrt
  :sig [(n : i64) -> i64]
  :intent "Compute floor(sqrt(n)) using integer arithmetic"
  :requires [(>= n 0)]
  :ensures [(>= result 0)]
  :body
    (if (<= n 1)
      n
      (isqrt-step n (/ n 2))))

;; Format per-task pass column: "PASS" for single run, "2/3" for multi-run
(defn format-run-pass
  :sig [(r : Map) (correct-key : String) (runs-key : String) -> String]
  :intent "Show PASS/FAIL or N/M run counts for multi-run results"
  :requires [(valid r)]
  :ensures [(valid result)]
  :body
    (let (runs-count : i64 (map-get-or r "runs-count" 1))
      (if (<= runs-count 1)
        (bool-str (map-get-or r correct-key false))
        (let (runs-passed : i64 (map-get-or r runs-key 0))
          (str (int-to-string runs-passed) "/" (int-to-string runs-count))))))

;; Compute mean pass percentage across tasks for a given runs-key
(defn compute-mean-pass-pct
  :sig [(results : List) (runs-key : String) -> i64]
  :intent "Average per-task pass percentage (0-100) across all tasks"
  :requires [(valid results)]
  :ensures [(>= result 0)]
  :body
    (let (n : i64 (length results))
      (if (= n 0)
        0
        (let (sum-pct : i64 (fold (fn [acc r]
                (let (runs : i64 (map-get-or r "runs-count" 1))
                     (passed : i64 (map-get-or r runs-key 0))
                  (+ acc (/ (* passed 100) runs))))
              0 results))
          (/ sum-pct n)))))

;; Compute stddev of per-task pass percentages
(defn compute-pass-stddev
  :sig [(results : List) (runs-key : String) -> i64]
  :intent "Standard deviation of per-task pass percentages (integer)"
  :requires [(valid results)]
  :ensures [(>= result 0)]
  :body
    (let (n : i64 (length results))
      (if (<= n 1)
        0
        (let (mean-pct : i64 (compute-mean-pass-pct results runs-key))
          (let (sum-sq : i64 (fold (fn [acc r]
                  (let (runs : i64 (map-get-or r "runs-count" 1))
                       (passed : i64 (map-get-or r runs-key 0))
                    (let (pct : i64 (/ (* passed 100) runs))
                         (diff : i64 (- pct mean-pct))
                      (+ acc (* diff diff)))))
                0 results))
            (isqrt (/ sum-sq n)))))))

;; Format "85% ± 12%" or "100%" when stddev is 0
(defn format-pct-with-stddev
  :sig [(mean-pct : i64) (stddev : i64) -> String]
  :intent "Format percentage with optional standard deviation"
  :requires [(>= mean-pct 0)]
  :ensures [(valid result)]
  :body
    (if (= stddev 0)
      (str (int-to-string mean-pct) "%")
      (str (int-to-string mean-pct) "% ± " (int-to-string stddev) "%")))

;; Detect which languages have data in results
(defn has-lang-data
  :sig [(results : List) (key : String) -> Bool]
  :intent "Check if any result has non-zero data for a language key"
  :requires [(valid results)]
  :ensures [(valid result)]
  :body (any (fn [r] (or (map-get-or r key false)
                         (> (map-get-or r (str key "-tok") 0) 0))) results))

;; Helper: build a single table row
(defn result-row
  :sig [(r : Map) (show-c : Bool) -> String]
  :intent "Generate one markdown table row from a result map"
  :requires [(map-has r "task-name")]
  :ensures [(starts-with result "| ")]
  :body
    (let (compile-ms : i64 (map-get-or r "airl-compile-ms" 0))
         (c-compile-ms : i64 (map-get-or r "c-compile-ms" 0))
      (str "| " (map-get-or r "task-name" "?")
           " | " (format-run-pass r "airl-correct" "airl-runs-passed")
           " | " (format-run-pass r "python-correct" "py-runs-passed")
           (if show-c (str " | " (format-run-pass r "c-correct" "c-runs-passed")) "")
           " | " (int-to-string (map-get-or r "airl-completion-tok" 0))
           " | " (int-to-string (map-get-or r "py-completion-tok" 0))
           (if show-c (str " | " (int-to-string (map-get-or r "c-completion-tok" 0))) "")
           (if (> compile-ms 0) (str " | " (int-to-string compile-ms)) "")
           " | " (int-to-string (map-get-or r "airl-time-ms" 0))
           " | " (int-to-string (map-get-or r "python-time-ms" 0))
           (if show-c
             (str (if (> c-compile-ms 0) (str " | " (int-to-string c-compile-ms)) "")
                  " | " (int-to-string (map-get-or r "c-time-ms" 0)))
             "")
           " | " (int-to-string (map-get-or r "airl-chars" 0))
           " | " (int-to-string (map-get-or r "python-chars" 0))
           (if show-c (str " | " (int-to-string (map-get-or r "c-chars" 0))) "")
           " | " (map-get-or r "output-match" "—")
           " |\n")))

;; Generate markdown results table
(defn generate-results-table
  :sig [(results : List) -> String]
  :intent "Generate a markdown table of per-task benchmark results"
  :requires [(valid results)]
  :ensures [(valid result)]
  :body
    (let (has-compile : Bool (any (fn [r] (> (map-get-or r "airl-compile-ms" 0) 0)) results))
         (show-c : Bool (any (fn [r] (or (map-get-or r "c-correct" false) (> (map-get-or r "c-completion-tok" 0) 0))) results))
         (has-c-compile : Bool (any (fn [r] (> (map-get-or r "c-compile-ms" 0) 0)) results))
         (header : String (str "| Task | AIRL | Python |"
                              (if show-c " C |" "")
                              " AIRL tok | Py tok |"
                              (if show-c " C tok |" "")
                              (if has-compile " AIRL compile |" "")
                              " AIRL ms | Py ms |"
                              (if show-c
                                (str (if has-c-compile " C compile |" "") " C ms |")
                                "")
                              " AIRL chars | Py chars |"
                              (if show-c " C chars |" "")
                              " Match |\n"))
         (separator : String (str "|------|------|--------|"
                                 (if show-c "---|" "")
                                 "----------|--------|"
                                 (if show-c "--------|" "")
                                 (if has-compile "-------------|" "")
                                 "---------|-------|"
                                 (if show-c
                                   (str (if has-c-compile "-----------|" "") "------|")
                                   "")
                                 "------------|----------|"
                                 (if show-c "---------|" "")
                                 "-------|\n"))
         (rows : String (fold (fn [acc r] (str acc (result-row r show-c))) "" results))
      (str header separator rows)))

;; Count correct results for a language
(defn count-correct
  :sig [(results : List) (key : String) -> i64]
  :intent "Count how many results have the given key as true"
  :requires [(valid results) (not (= key ""))]
  :ensures [(and (>= result 0) (<= result (length results)))]
  :body (fold (fn [acc r] (+ acc (if (map-get-or r key false) 1 0))) 0 results))

;; Sum a numeric field across results
(defn sum-field
  :sig [(results : List) (key : String) -> i64]
  :intent "Sum a numeric field across all result maps"
  :requires [(valid results) (not (= key ""))]
  :ensures [(>= result 0)]
  :body (fold (fn [acc r] (+ acc (map-get-or r key 0))) 0 results))

;; Count output matches
(defn count-matches
  :sig [(results : List) -> i64]
  :intent "Count results where output-match is yes"
  :requires [(valid results)]
  :ensures [(and (>= result 0) (<= result (length results)))]
  :body (fold (fn [acc r] (+ acc (if (= (map-get-or r "output-match" "—") "yes") 1 0))) 0 results))

;; Format a ratio as N.NN× string (integer math: ratio * 100, then insert decimal)
(defn format-ratio
  :sig [(num : i64) (denom : i64) -> String]
  :intent "Compute num/denom as a fixed-point ratio string like 1.23×, or — if denom is zero"
  :requires [(>= num 0) (>= denom 0)]
  :ensures [(valid result)]
  :body
    (if (= denom 0)
      "—"
      (let (scaled : i64 (/ (* num 100) denom))
           (whole : i64 (/ scaled 100))
           (frac : i64 (- scaled (* whole 100)))
           (frac-str : String (if (< frac 10)
                                (str "0" (int-to-string frac))
                                (int-to-string frac)))
        (str (int-to-string whole) "." frac-str "×"))))

;; Generate token usage section
(defn generate-token-section
  :sig [(results : List) -> String]
  :intent "Generate token usage breakdown separating completion tokens from prompt tokens"
  :requires [(valid results)]
  :ensures [(valid result)]
  :body
    (let (total : i64 (length results))
         (airl-comp-total : i64 (sum-field results "airl-completion-tok"))
         (py-comp-total : i64 (sum-field results "py-completion-tok"))
         (airl-prompt-total : i64 (sum-field results "airl-prompt-tok"))
         (py-prompt-total : i64 (sum-field results "py-prompt-tok"))
         (airl-comp-avg : i64 (if (= total 0) 0 (/ airl-comp-total total)))
         (py-comp-avg : i64 (if (= total 0) 0 (/ py-comp-total total)))
         (airl-prompt-avg : i64 (if (= total 0) 0 (/ airl-prompt-total total)))
         (py-prompt-avg : i64 (if (= total 0) 0 (/ py-prompt-total total)))
      (str "### Token Usage\n\n"
           "| | AIRL | Python | Ratio |\n"
           "|---|------|--------|-------|\n"
           "| Completion tokens (total) | " (int-to-string airl-comp-total) " | " (int-to-string py-comp-total) " | " (format-ratio airl-comp-total py-comp-total) " |\n"
           "| Completion tokens (avg/task) | " (int-to-string airl-comp-avg) " | " (int-to-string py-comp-avg) " | |\n"
           "| Prompt tokens (avg/task) | " (int-to-string airl-prompt-avg) " | " (int-to-string py-prompt-avg) " | |\n"
           "\n*Prompt tokens include the LLM guide (~13k for AIRL, ~500 for Python) — not comparable.*\n")))

;; Generate summary statistics
(defn generate-summary
  :sig [(results : List) -> String]
  :intent "Generate aggregate statistics from benchmark results"
  :requires [(valid results)]
  :ensures [(valid result)]
  :body
    (let (total : i64 (length results))
         (airl-pass : i64 (count-correct results "airl-correct"))
         (py-pass : i64 (count-correct results "python-correct"))
         (c-pass : i64 (count-correct results "c-correct"))
         (show-c : Bool (> (sum-field results "c-completion-tok") 0))
         (c-gen-total : i64 (sum-field results "c-completion-tok"))
         (total-airl-ms : i64 (sum-field results "airl-time-ms"))
         (total-compile-ms : i64 (sum-field results "airl-compile-ms"))
         (total-py-ms : i64 (sum-field results "python-time-ms"))
         (total-c-ms : i64 (sum-field results "c-time-ms"))
         (total-c-compile : i64 (sum-field results "c-compile-ms"))
         (matches : i64 (count-matches results))
         (has-multi-run : Bool (any (fn [r] (> (map-get-or r "runs-count" 1) 1)) results))
         (multi-run-n : i64 (if has-multi-run (map-get-or (at results 0) "runs-count" 1) 1))
      (str "## Summary\n\n"
           "- **AIRL correct:** " (int-to-string airl-pass) " / " (int-to-string total) "\n"
           "- **Python correct:** " (int-to-string py-pass) " / " (int-to-string total) "\n"
           (if show-c (str "- **C correct:** " (int-to-string c-pass) " / " (int-to-string total) "\n") "")
           "- **Output matches:** " (int-to-string matches) " / " (int-to-string total) "\n"
           (if has-multi-run
             (str "\n### Variance Analysis (" (int-to-string multi-run-n) " runs per task)\n\n"
                  "- **AIRL mean pass rate:** "
                  (format-pct-with-stddev
                    (compute-mean-pass-pct results "airl-runs-passed")
                    (compute-pass-stddev results "airl-runs-passed")) "\n"
                  "- **Python mean pass rate:** "
                  (format-pct-with-stddev
                    (compute-mean-pass-pct results "py-runs-passed")
                    (compute-pass-stddev results "py-runs-passed")) "\n"
                  (if show-c
                    (str "- **C mean pass rate:** "
                         (format-pct-with-stddev
                           (compute-mean-pass-pct results "c-runs-passed")
                           (compute-pass-stddev results "c-runs-passed")) "\n")
                    ""))
             "")
           "\n"
           (generate-token-section results)
           (if show-c (str "\n| C completion (total) | " (int-to-string c-gen-total) " |\n") "")
           "\n### Execution\n\n"
           "- **Total AIRL execution time:** " (int-to-string total-airl-ms) " ms\n"
           (if (> total-compile-ms 0) (str "- **Total AIRL compile time:** " (int-to-string total-compile-ms) " ms\n") "")
           "- **Total Python execution time:** " (int-to-string total-py-ms) " ms\n"
           (if show-c (str "- **Total C execution time:** " (int-to-string total-c-ms) " ms\n") "")
           (if (> total-c-compile 0) (str "- **Total C compile time:** " (int-to-string total-c-compile) " ms\n") ""))))

;; Generate findings document
(defn generate-findings
  :sig [(model : String) (results : List) (guide-included : Bool) (airl-bin : String) -> String]
  :intent "Generate a complete findings document for archiving a benchmark run"
  :requires [(not (= model ""))]
  :ensures [(not (= result ""))]
  :body
    (let (total : i64 (length results))
         (airl-pass : i64 (count-correct results "airl-correct"))
         (py-pass : i64 (count-correct results "python-correct"))
         (c-pass : i64 (count-correct results "c-correct"))
         (show-c : Bool (> (sum-field results "c-completion-tok") 0))
         (total-airl-ms : i64 (sum-field results "airl-time-ms"))
         (total-compile-ms : i64 (sum-field results "airl-compile-ms"))
         (total-py-ms : i64 (sum-field results "python-time-ms"))
         (total-c-ms : i64 (sum-field results "c-time-ms"))
         (airl-pct : i64 (if (= total 0) 0 (/ (* airl-pass 100) total)))
         (py-pct : i64 (if (= total 0) 0 (/ (* py-pass 100) total)))
         (c-pct : i64 (if (= total 0) 0 (/ (* c-pass 100) total)))
      (str "# AIRL_bench Findings\n\n"
           "**Model:** " model "\n"
           "**Guide included:** " (if guide-included "Yes (airl_llm_guide.md)" "No") "\n"
           "**AIRL binary:** " airl-bin "\n"
           "**Mode:** " (if (> total-compile-ms 0) "compiled (AOT)" "interpreted") "\n"
           "**Tasks:** " (int-to-string total) "\n"
           (if (> (length results) 0)
             (if (> (map-get-or (at results 0) "runs-count" 1) 1)
               (str "**Runs per task:** " (int-to-string (map-get-or (at results 0) "runs-count" 1)) "\n")
               "")
             "")
           "\n## Results\n\n"
           (generate-results-table results)
           "\n## Summary\n\n"
           "- **AIRL correct:** " (int-to-string airl-pass) " / " (int-to-string total) " (" (int-to-string airl-pct) "%)\n"
           "- **Python correct:** " (int-to-string py-pass) " / " (int-to-string total) " (" (int-to-string py-pct) "%)\n"
           (if show-c (str "- **C correct:** " (int-to-string c-pass) " / " (int-to-string total) " (" (int-to-string c-pct) "%)\n") "")
           "\n"
           (generate-token-section results)
           "\n### Execution\n\n"
           "- **Total AIRL execution time:** " (int-to-string total-airl-ms) " ms\n"
           (if (> total-compile-ms 0) (str "- **Total AIRL compile time:** " (int-to-string total-compile-ms) " ms\n") "")
           "- **Total Python execution time:** " (int-to-string total-py-ms) " ms\n"
           (if show-c (str "- **Total C execution time:** " (int-to-string total-c-ms) " ms\n") "")
           "\n"
           (generate-summary results))))

;; Generate full benchmark report
(defn generate-report
  :sig [(model : String) (results : List) -> String]
  :intent "Generate a complete markdown benchmark report"
  :requires [(not (= model ""))]
  :ensures [(not (= result ""))]
  :body
    (str "# AIRL_bench Report\n\n"
         "**Model:** " model "\n\n"
         "## Results\n\n"
         (generate-results-table results)
         "\n"
         (generate-summary results)))
