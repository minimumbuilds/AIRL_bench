;; runner.airl — Execute generated code and time it
;; v0.8.0: multi-test-case support via ---TESTS--- section

;; ── Multi-test-case parsing ───────────────────────────────────────

;; Parse test cases from task content. Returns list of maps with "input" and "expected" keys.
;; Lines after ---TESTS--- that contain " => " are parsed as test cases.
;; Returns empty list if no ---TESTS--- section is found.
(defn parse-test-cases
  :sig [(task-content : String) -> List]
  :intent "Extract test cases from ---TESTS--- section of a task file"
  :requires [(valid task-content)]
  :ensures [(valid result)]
  :body
    (let (parts : List (split task-content "---TESTS---"))
      (if (< (length parts) 2)
        []
        (let (test-section : String (trim (at parts 1)))
             (lines : List (filter (fn [l] (contains l " => ")) (split test-section "\n")))
          (map (fn [line]
                 (let (halves : List (split line " => "))
                   (map-from ["input"    (trim (at halves 0))
                              "expected" (trim (at halves 1))])))
               lines)))))

;; Check whether a single execution stdout matches a test case's expected output.
(defn test-case-passes
  :sig [(stdout : String) (expected : String) -> Bool]
  :intent "Return true if the trimmed stdout equals the expected output"
  :requires [(valid stdout) (valid expected)]
  :ensures [(valid result)]
  :body (= (trim stdout) (trim expected)))

;; Run all test cases for a language and return aggregated result.
;; exec-fn is called with a single-arg string for input injection; it returns a runner result Map.
;; When test-cases is empty, falls back to a single no-arg execution (legacy behavior).
(defn run-with-tests
  :sig [(exec-fn : _) (test-cases : List) -> Map]
  :intent "Execute a program once per test case; require ALL to pass; return combined result map"
  :requires [(valid exec-fn) (valid test-cases)]
  :ensures [(map-has result "success") (map-has result "stdout") (map-has result "elapsed-ms")]
  :body
    (if (= (length test-cases) 0)
      ;; Legacy: single execution, no test case filtering
      (exec-fn "")
      ;; Multi-test: run each case; all must pass
      (let (first-result : Map (exec-fn (map-get-or (at test-cases 0) "input" "")))
           (results : List (map (fn [tc]
                                  (let (r : Map (exec-fn (map-get-or tc "input" "")))
                                    (map-set r "expected" (map-get-or tc "expected" ""))))
                                test-cases))
           (all-pass : Bool (all (fn [r]
                                    (test-case-passes
                                      (map-get-or r "stdout" "")
                                      (map-get-or r "expected" "")))
                                  results))
           (total-elapsed : i64 (fold (fn [acc r] (+ acc (map-get-or r "elapsed-ms" 0))) 0 results))
           (last-stdout : String (map-get-or (at results (- (length results) 1)) "stdout" ""))
        (map-from
          ["success"    all-pass
           "stdout"     last-stdout
           "elapsed-ms" total-elapsed
           "stderr"     (map-get-or first-result "stderr" "")]))))

;; Run a Python script and return execution results with timing
(defn run-python
  :sig [(filepath : String) -> Map]
  :intent "Execute a Python file via python3, return result map with timing"
  :requires [(not (= filepath ""))]
  :ensures [(map-has result "success") (map-has result "stdout") (map-has result "elapsed-ms")]
  :body
    (let (start : i64 (time-now))
         (exec-result : _ (shell-exec "python3" [filepath]))
         (elapsed : i64 (- (time-now) start))
      (match exec-result
        (Ok out-map) (map-from
          ["success"    (= (map-get-or out-map "exit-code" 0) 0)
           "stdout"     (map-get-or out-map "stdout" "")
           "stderr"     (map-get-or out-map "stderr" "")
           "elapsed-ms" elapsed])
        (Err e) (map-from
          ["success"    false
           "stdout"     ""
           "stderr"     e
           "elapsed-ms" elapsed]))))

;; Run an AIRL file via the interpreter and return results with timing
(defn run-airl
  :sig [(airl-bin : String) (filepath : String) -> Map]
  :intent "Execute an AIRL file via the given airl binary, return result map with timing"
  :requires [(not (= filepath "")) (not (= airl-bin ""))]
  :ensures [(map-has result "success") (map-has result "stdout") (map-has result "elapsed-ms")]
  :body
    (let (start : i64 (time-now))
         (exec-result : _ (shell-exec airl-bin ["run" filepath]))
         (elapsed : i64 (- (time-now) start))
      (match exec-result
        (Ok out-map) (map-from
          ["success"    (= (map-get-or out-map "exit-code" 0) 0)
           "stdout"     (map-get-or out-map "stdout" "")
           "stderr"     (map-get-or out-map "stderr" "")
           "elapsed-ms" elapsed])
        (Err e) (map-from
          ["success"    false
           "stdout"     ""
           "stderr"     e
           "elapsed-ms" elapsed]))))

;; Compile an AIRL file to a native binary via AOT
(defn compile-airl
  :sig [(airl-bin : String) (source-path : String) (output-path : String) -> Map]
  :intent "AOT compile an AIRL file to a native binary, return compile result with timing"
  :requires [(not (= source-path "")) (not (= airl-bin ""))]
  :ensures [(map-has result "success") (map-has result "elapsed-ms")]
  :body
    (let (start : i64 (time-now))
         (compile-result : _ (shell-exec airl-bin ["compile" source-path "-o" output-path]))
         (elapsed : i64 (- (time-now) start))
      (match compile-result
        (Ok out-map) (map-from
          ["success"    (= (map-get-or out-map "exit-code" 0) 0)
           "stderr"     (map-get-or out-map "stderr" "")
           "elapsed-ms" elapsed])
        (Err e) (map-from
          ["success"    false
           "stderr"     e
           "elapsed-ms" elapsed]))))

;; Run a pre-compiled native binary
(defn run-compiled
  :sig [(binary-path : String) -> Map]
  :intent "Execute a compiled native AIRL binary, return result map with timing"
  :requires [(not (= binary-path ""))]
  :ensures [(map-has result "success") (map-has result "stdout") (map-has result "elapsed-ms")]
  :body
    (let (start : i64 (time-now))
         (exec-result : _ (shell-exec binary-path []))
         (elapsed : i64 (- (time-now) start))
      (match exec-result
        (Ok out-map) (map-from
          ["success"    (= (map-get-or out-map "exit-code" 0) 0)
           "stdout"     (map-get-or out-map "stdout" "")
           "stderr"     (map-get-or out-map "stderr" "")
           "elapsed-ms" elapsed])
        (Err e) (map-from
          ["success"    false
           "stdout"     ""
           "stderr"     e
           "elapsed-ms" elapsed]))))

;; Compile a C file to a native binary via gcc
(defn compile-c
  :sig [(source-path : String) (output-path : String) -> Map]
  :intent "Compile a C file with gcc, return compile result with timing"
  :requires [(not (= source-path ""))]
  :ensures [(map-has result "success") (map-has result "elapsed-ms")]
  :body
    (let (start : i64 (time-now))
         (compile-result : _ (shell-exec "gcc" ["-std=c11" "-O2" "-o" output-path source-path "-lm"]))
         (elapsed : i64 (- (time-now) start))
      (match compile-result
        (Ok out-map) (map-from
          ["success"    (= (map-get-or out-map "exit-code" 0) 0)
           "stderr"     (map-get-or out-map "stderr" "")
           "elapsed-ms" elapsed])
        (Err e) (map-from
          ["success"    false
           "stderr"     e
           "elapsed-ms" elapsed]))))

;; Compile and run a C file — returns combined result with separate timings
(defn run-c-compiled
  :sig [(source-path : String) (binary-path : String) -> Map]
  :intent "Compile C with gcc then execute, tracking compile and execution time separately"
  :requires [(not (= source-path ""))]
  :ensures [(map-has result "success") (map-has result "stdout") (map-has result "elapsed-ms")]
  :body
    (let (compile-res : Map (compile-c source-path binary-path))
      (if (map-get compile-res "success")
        (let (exec-res : Map (run-compiled binary-path))
          (map-set (map-set exec-res
            "compile-ms" (map-get compile-res "elapsed-ms"))
            "elapsed-ms" (map-get exec-res "elapsed-ms")))
        ;; Compilation failed
        (map-from
          ["success"    false
           "stdout"     ""
           "stderr"     (str "compile error: " (map-get compile-res "stderr"))
           "compile-ms" (map-get compile-res "elapsed-ms")
           "elapsed-ms" 0]))))

;; Compile and run an AIRL file — returns combined result with separate timings
(defn run-airl-compiled
  :sig [(airl-bin : String) (source-path : String) (binary-path : String) -> Map]
  :intent "AOT compile then execute, tracking compile and execution time separately"
  :requires [(not (= source-path "")) (not (= airl-bin ""))]
  :ensures [(map-has result "success") (map-has result "stdout") (map-has result "elapsed-ms")]
  :body
    (let (compile-res : Map (compile-airl airl-bin source-path binary-path))
      (if (map-get compile-res "success")
        (let (exec-res : Map (run-compiled binary-path))
          (map-set (map-set exec-res
            "compile-ms" (map-get compile-res "elapsed-ms"))
            "elapsed-ms" (map-get exec-res "elapsed-ms")))
        ;; Compilation failed
        (map-from
          ["success"    false
           "stdout"     ""
           "stderr"     (str "compile error: " (map-get compile-res "stderr"))
           "compile-ms" (map-get compile-res "elapsed-ms")
           "elapsed-ms" 0]))))

;; ── Error classification ─────────────────────────────────────────

;; Classify stderr output into an error category by pattern-matching
(defn classify-stderr
  :sig [(stderr : String) -> String]
  :intent "Pattern-match stderr to determine error category"
  :requires [(valid stderr)]
  :ensures [(valid result)]
  :body
    (if (contains stderr "parse error") "syntax"
      (if (contains stderr "unexpected token") "syntax"
        (if (contains stderr "unbalanced") "syntax"
          (if (contains stderr "type mismatch") "type"
            (if (contains stderr "expected")
              (if (contains stderr "got") "type"
                (if (contains stderr "undefined") "wrong_function"
                  (if (contains stderr "not found") "wrong_function"
                    "unknown")))
              (if (contains stderr "undefined") "wrong_function"
                (if (contains stderr "not found") "wrong_function"
                  (if (contains stderr "wrong number of arguments") "wrong_function"
                    (if (contains stderr "arity") "wrong_function"
                      (if (contains stderr "exhaustive") "control_flow"
                        (if (contains stderr "unreachable") "control_flow"
                          (if (contains stderr "linearity") "ownership"
                            (if (contains stderr "moved") "ownership"
                              (if (contains stderr "use after") "ownership"
                                (if (contains stderr "contract") "contract"
                                  (if (contains stderr "requires") "contract"
                                    (if (contains stderr "ensures") "contract"
                                      (if (contains stderr "assertion") "logic"
                                        "unknown")))))))))))))))))))

;; Classify an execution failure into an error category.
;; Returns "" for passing tasks, a category string for failures.
(defn classify-error
  :sig [(stderr : String) (exec-success : Bool) (correct : Bool) -> String]
  :intent "Return error category for failed tasks, empty string for passing tasks"
  :requires [(valid stderr)]
  :ensures [(valid result)]
  :body
    (if correct ""
      (if (not exec-success)
        (classify-stderr stderr)
        "logic")))
